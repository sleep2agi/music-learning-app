<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 / Electron JIT under Hardened Runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Electron frameworks are already signed; library validation rejects them under Hardened Runtime. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Update checks and other outbound HTTPS. This does not enable the App Sandbox. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
